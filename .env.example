# Set locally to a WebSocket endpoint you are authorized to access.
# The endpoint has not been verified by this project.
CRASH_WS_URL=
WS_TIMEOUT_SECONDS=15
MAX_MESSAGES=100

# Optional schema mapping. Leave all parser fields blank until confirmed.
CRASH_EVENT_TYPE_PATH=
CRASH_FINAL_EVENT_TYPES=
CRASH_ROUND_ID_PATH=
CRASH_MULTIPLIER_PATH=
CRASH_TIMESTAMP_PATH=
CRASH_SCHEMA_VERSION=unconfirmed

# Private server-side persistence. Keep these values in local .env only.
# Never place the service-role key in frontend code, Pages, or public CI logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
